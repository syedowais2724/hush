{
  "name": "hush",
  "productName": "Hush",
  "version": "0.1.0",
  "private": true,
  "description": "Private, on-device dictation for Windows",
  "author": "Hush",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:installer": "npm run build && electron-builder --win nsis",
    "dist:lite": "npm run build && electron-builder --win portable --config electron-builder-lite.yml",
    "test:stt": "node scripts/test-stt.mjs"
  },
  "dependencies": {
    "koffi": "^3.3.6",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cactus-needle": "^0.3.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.66.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.2",
    "vite": "^8.3.5",
    "wait-on": "^9.0.1"
  }
}
